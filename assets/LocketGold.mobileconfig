<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>PayloadDisplayName</key>
    <string>Locket Gold 💛</string>

    <key>PayloadDescription</key>
    <string>Hồ sơ cấu hình chống thu hồi Locket Gold vĩnh viễn (Split DNS tối ưu tốc độ &amp; ổn định).</string>

    <key>PayloadIdentifier</key>
    <string>io.locketgold.dns.profile</string>

    <key>PayloadScope</key>
    <string>System</string>

    <key>PayloadType</key>
    <string>Configuration</string>

    <key>PayloadUUID</key>
    <string>A1E2F262-DB73-40F6-BD22-2E42A43A3C94</string>

    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>PayloadContent</key>
    <array>
      <dict>
        <key>DNSSettings</key>
        <dict>
          <key>DNSProtocol</key>
          <string>HTTPS</string>

          <key>ServerAddresses</key>
          <array>
            <string>1.1.1.1</string>
            <string>1.0.0.1</string>
          </array>

          <key>ServerURL</key>
          <string>https://my.ublockdns.com/z451ak95</string>

          <!-- Split DNS: Chỉ chuyển tiếp các tên miền của Locket & Apple revocation để chặn thu hồi -->
          <key>SupplementalMatchDomains</key>
          <array>
            <string>api.revenuecat.com</string>
            <string>app.revenuecat.com</string>
            <string>in.appcenter.ms</string>
            <string>app-measurement.com</string>
            <string>firebaselogging-pa.googleapis.com</string>
            <string>mixpanel.com</string>
            <string>api.mixpanel.com</string>
            <string>ocsp.apple.com</string>
            <string>ppq.apple.com</string>
          </array>
        </dict>

        <key>OnDemandRules</key>
        <array>
          <!-- Bỏ qua Captive Portal để không bị kẹt khi đăng nhập Wi-Fi công cộng -->
          <dict>
            <key>Action</key>
            <string>EvaluateConnection</string>
            <key>ActionParameters</key>
            <array>
              <dict>
                <key>DomainAction</key>
                <string>NeverConnect</string>
                <key>Domains</key>
                <array>
                  <string>captive.apple.com</string>
                  <string>3gppnetwork.org</string>
                  <string>dav.orange.fr</string>
                  <string>vvm.mobistar.be</string>
                  <string>vvm.mstore.msg.t-mobile.com</string>
                  <string>tma.vvm.mone.pan-net.eu</string>
                  <string>vvm.ee.co.uk</string>
                </array>
              </dict>
            </array>
          </dict>

          <!-- Tự động kích hoạt khi có kết nối Wi-Fi -->
          <dict>
            <key>Action</key>
            <string>Connect</string>
            <key>InterfaceTypeMatch</key>
            <string>WiFi</string>
          </dict>

          <!-- Tự động kích hoạt khi dùng mạng di động 4G/5G -->
          <dict>
            <key>Action</key>
            <string>Connect</string>
            <key>InterfaceTypeMatch</key>
            <string>Cellular</string>
          </dict>
        </array>

        <key>PayloadType</key>
        <string>com.apple.dnsSettings.managed</string>

        <key>PayloadIdentifier</key>
        <string>io.locketgold.dns.profile.managed</string>

        <key>PayloadUUID</key>
        <string>B2E3F475-EB84-41F7-CE33-3F53B54B4DA5</string>

        <key>PayloadDisplayName</key>
        <string>Locket Gold DNS Server</string>

        <key>PayloadOrganization</key>
        <string>Locket Gold VIP</string>

        <key>PayloadVersion</key>
        <integer>1</integer>
      </dict>
    </array>

    <key>PayloadOrganization</key>
    <string>Locket Gold VIP</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
  </dict>
</plist>
